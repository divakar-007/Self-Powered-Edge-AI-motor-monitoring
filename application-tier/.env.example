# Application Tier Configuration
APP_NAME="MEMS Industrial Monitoring System"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# SQLite Database
SQLITE_DB_PATH="../data-tier/sqlite/mems_industrial.db"

# InfluxDB Configuration (Docker or Cloud)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=mems-industrial-secret-token-2026
INFLUXDB_ORG=mems_org
INFLUXDB_BUCKET=motor_telemetry

# Mosquitto MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEP_ALIVE=60
MQTT_TOPIC_SENSORS=mems/motor001/sensors
MQTT_TOPIC_STATUS=mems/motor001/status
MQTT_TOPIC_ALERTS=mems/motor001/alerts

# Machine Identification
DEFAULT_MACHINE_ID=MOTOR_001
DEFAULT_DEVICE_ID=ESP32_001

# Default Thresholds (Motor Health)
THRESHOLD_TEMP_WARNING=45.0
THRESHOLD_TEMP_CRITICAL=60.0
THRESHOLD_VIB_WARNING=3.0
THRESHOLD_VIB_CRITICAL=5.0
THRESHOLD_CURRENT_WARNING=1.0
THRESHOLD_CURRENT_CRITICAL=1.5
THRESHOLD_PIEZO_WARNING=3.8
THRESHOLD_PIEZO_CRITICAL=4.5

# Simulator Settings
SIMULATOR_INTERVAL_SECONDS=1.0
SIMULATOR_AUTO_START=True
