%% Figure 4.5 - ESP32-S3 Microcontroller Pinout and GPIO Assignment
flowchart LR
    subgraph ESP32S3["ESP32-S3 DevKit Pin Mapping"]
        P_3V3["Pin 3V3 (3.3V DC Power Rail)"]
        P_5V["Pin 5V / VBUS (5.0V USB Power Rail)"]
        P_GND["Pin GND (Ground Reference 0V)"]
        
        P_GPIO8["GPIO 8 (I2C SDA)"]
        P_GPIO9["GPIO 9 (I2C SCL)"]
        P_GPIO4["GPIO 4 (OneWire Digital Data)"]
        P_GPIO1["GPIO 1 (ADC1 Channel 0)"]
        P_GPIO2["GPIO 2 (ADC1 Channel 1)"]
    end

    subgraph Peripherals["Connected Sensors & Subsystems"]
        S_MPU["MPU6050 (VCC=3.3V, GND=0V,\nSDA=GPIO8, SCL=GPIO9)"]
        S_DS["DS18B20 (VDD=3.3V, GND=0V,\nDATA=GPIO4 with 4.7k Pull-Up)"]
        S_ACS["ACS712 (VCC=5.0V, GND=0V,\nOUT conditioned to GPIO1)"]
        S_PZT["Piezoelectric Transducer\n(Conditioned & Clamped to GPIO2)"]
    end

    P_3V3 -->|Power 3.3V| S_MPU & S_DS
    P_5V -->|Power 5.0V| S_ACS
    P_GND -->|Common Ground| S_MPU & S_DS & S_ACS & S_PZT

    S_MPU <--> P_GPIO8 & P_GPIO9
    S_DS <--> P_GPIO4
    S_ACS --> P_GPIO1
    S_PZT --> P_GPIO2
